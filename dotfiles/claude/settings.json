{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "cleanupPeriodDays": 90,
  "syncClaudeAiSkills": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-pr-merge.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-pr-ready.sh"
          },
          {
            "type": "command",
            "command": "~/.claude/hooks/block-review-requests.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    }
  },
  "outputStyle": "ASD-STE100",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "totalTokensReminder": "countdown",
  "switchModelsOnFlag": false,
  "agentPushNotifEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "autoCompactWindow": 400000
    }
  }
}
